{
  "name": "emergency-care-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An example emergency care system: a SvelteKit demo app (fictitious data, no real backend), its specs, skills, and Selenium test suite.",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "mocha",
    "test:selenium": "mocha",
    "test:selenium-typescript": "mocha --config .mocharc.selenium-typescript.json",
    "test:playwright": "playwright test",
    "test:playwright-typescript": "playwright test --config=playwright.typescript.config.ts",
    "test:selenium-python": "pytest tests-with-selenium-python",
    "test:playwright-python": "pytest tests-with-playwright-python",
    "test:selenium-c-sharp": "dotnet test tests-with-selenium-c-sharp",
    "test:playwright-c-sharp": "dotnet test tests-with-playwright-c-sharp",
    "test:selenium-java": "mvn -f tests-with-selenium-java/pom.xml test",
    "test:playwright-java": "mvn -f tests-with-playwright-java/pom.xml test",
    "test:selenium-rust": "cargo test --manifest-path tests-with-selenium-rust/Cargo.toml",
    "test:playwright-rust": "cargo test --manifest-path tests-with-playwright-rust/Cargo.toml"
  },
  "dependencies": {
    "lily-design-system-svelte-headless": "^0.3.1",
    "@svar-ui/svelte-core": "^2.6.1",
    "@svar-ui/svelte-grid": "^2.7.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@playwright/test": "^1.63.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/selenium-webdriver": "^4.35.6",
    "mocha": "^10.7.3",
    "selenium-webdriver": "^4.25.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
