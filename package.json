{
  "name": "emergency-department-management-system-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An example ED management system: a SvelteKit demo app (fictitious data, no real backend), its specs, skills, and Selenium test suite.",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "mocha"
  },
  "dependencies": {
    "lily-design-system-svelte-headless": "^0.3.1",
    "@svar-ui/svelte-core": "^2.6.1",
    "@svar-ui/svelte-grid": "^2.7.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "mocha": "^10.7.3",
    "selenium-webdriver": "^4.25.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
