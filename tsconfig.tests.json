{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "mocha"]
  },
  "include": ["tests-with-selenium-typescript/**/*.ts", "tests-with-playwright-typescript/**/*.ts"]
}
